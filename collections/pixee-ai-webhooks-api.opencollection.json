{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pixee REST Findings Webhooks API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List registered webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.pixee.ai/api/v1/webhooks"
          },
          "docs": "List registered webhooks"
        },
        {
          "info": {
            "name": "Register a webhook endpoint",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.pixee.ai/api/v1/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register a webhook endpoint"
        },
        {
          "info": {
            "name": "Remove a webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.pixee.ai/api/v1/webhooks/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove a webhook"
        }
      ]
    }
  ],
  "bundled": true
}