  "info": {
    "_postman_id": "e19215ed-270b-429d-962c-c22c509f8c8f",
    "name": "Pixee REST Findings API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Pixee provides a REST API for programmatic access to vulnerability triage and remediation workflows. The API enables querying fix status, managing repository configurations, listing scans and findings, and registering webhook endpoints for CI/CD integration. Authentication uses organization-scoped bearer API tokens. The API is a HAL (Hypertext Application Language) API: every response includes `_links` that name related resources; clients start at `/api/v1` and follow `_links`.\nThis description is a faithful reconstruction of the endpoints documented at https://docs.pixee.ai/api/overview and https://docs.pixee.ai/api/webhooks. It is not the provider's own machine-readable specification (none was published at a discoverable URL as of the generated date).\n\nContact Support:\n Name: Pixee",
      "type": "text/plain"
    }
  }
